{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/sdd/scripts/rule-zero-hook.mjs\" claude",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/sdd/scripts/rtk-hook.mjs\" claude",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "video-maker": {
      "source": {
        "source": "github",
        "repo": "e-burgos/video-maker"
      }
    }
  },
  "enabledPlugins": {
    "video-maker@video-maker": true
  }
}
