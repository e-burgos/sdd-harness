{
  "name": "sdd-harness-workspace",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "pnpm --filter @e-burgos/sdd-harness build",
    "test": "pnpm --filter @e-burgos/sdd-harness test",
    "test:watch": "pnpm --filter @e-burgos/sdd-harness test:watch",
    "typecheck": "pnpm --filter @e-burgos/sdd-harness typecheck",
    "dev:docs": "cd apps/documentation && pnpm dev"
  }
}
