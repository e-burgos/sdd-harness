{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "sdd/schemas/cycle.schema.json",
  "title": "SDD Cycle State (sdd/specs/{spec-id}/cycles/cycle-XX/cycle.json)",
  "description": "State of one cycle. Created by sdd-orchestrator with status in-progress; only sdd-reviewer may set status completed (after the CONTEXTO GATE).",
  "type": "object",
  "required": [
    "cycle",
    "module",
    "spec",
    "apps",
    "status",
    "started_at",
    "completed_at",
    "documents",
    "artifacts",
    "metrics",
    "tables_created",
    "endpoints_implemented",
    "components_created",
    "issues_found",
    "reviewer_report"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "cycle": { "type": "integer", "minimum": 1 },
    "module": { "type": "string", "minLength": 1 },
    "spec": {
      "type": "string",
      "pattern": "^spec-[a-z0-9-]+-\\d{3}-[a-z0-9-]+$"
    },
    "apps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^(apps|libs|tools)/[a-z][a-z0-9-]*$"
      }
    },
    "phase": { "type": "string" },
    "flow": { "enum": ["full", "reduced"] },
    "objectives": { "type": "array", "items": { "type": "string" } },
    "status": { "enum": ["in-progress", "completed"] },
    "started_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "completed_at": {
      "oneOf": [
        { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        { "type": "null" }
      ]
    },
    "documents": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "brief": { "type": "string" },
        "functional": { "type": "string" },
        "planner": { "type": "string" },
        "architect": { "type": "string" },
        "tasks": {
          "type": "string",
          "description": "Path to the per-cycle tasks.json"
        }
      },
      "description": "Paths of the cycle documents that exist. flow: reduced cycles may omit functional/planner/architect."
    },
    "artifacts": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Support docs under cycle-XX/artifacts/, not implemented source files."
    },
    "metrics": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": [
            "tasks_total",
            "tasks_completed",
            "story_points",
            "files_created",
            "files_modified",
            "files_deleted"
          ],
          "additionalProperties": false,
          "properties": {
            "tasks_total": { "type": "integer", "minimum": 0 },
            "tasks_completed": { "type": "integer", "minimum": 0 },
            "story_points": { "type": "number", "minimum": 0 },
            "files_created": { "type": "array", "items": { "type": "string" } },
            "files_modified": {
              "type": "array",
              "items": { "type": "string" }
            },
            "files_deleted": { "type": "array", "items": { "type": "string" } },
            "usage": {
              "type": "object",
              "required": ["tokens_in", "tokens_out"],
              "additionalProperties": false,
              "description": "Optional aggregated telemetry: approximate tokens/time for the whole cycle, recorded by the reviewer at close. Feeds the viewer's Costs dashboard.",
              "properties": {
                "tokens_in": { "type": "integer", "minimum": 0 },
                "tokens_out": { "type": "integer", "minimum": 0 },
                "duration_minutes": { "type": "number", "minimum": 0 },
                "by_tier": {
                  "type": "object",
                  "additionalProperties": false,
                  "propertyNames": { "enum": ["haiku", "sonnet", "opus", "fable"] },
                  "patternProperties": {
                    "^(haiku|sonnet|opus|fable)$": {
                      "type": "object",
                      "required": ["tokens_in", "tokens_out"],
                      "additionalProperties": false,
                      "properties": {
                        "tokens_in": { "type": "integer", "minimum": 0 },
                        "tokens_out": { "type": "integer", "minimum": 0 }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "tables_created": { "type": "array", "items": { "type": "string" } },
    "endpoints_implemented": {
      "type": "array",
      "items": { "type": "string", "pattern": "^EP-\\d{3}$" }
    },
    "components_created": {
      "type": "array",
      "items": { "type": "string", "pattern": "^COMP-\\d{3}$" }
    },
    "issues_found": { "type": "array", "items": { "type": "string" } },
    "reviewer_report": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["approved", "date", "ca_results", "tests", "notes"],
          "additionalProperties": false,
          "properties": {
            "approved": { "type": "boolean" },
            "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
            "ca_results": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            },
            "tests": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            },
            "notes": { "type": "string" },
            "follow_ups": { "type": "array", "items": { "type": "string" } }
          }
        }
      ]
    }
  }
}
