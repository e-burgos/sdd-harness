{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "sdd/schemas/cycle.schema.json",
  "title": "SDD Cycle State (sdd/specs/{spec-id}/cycles/cycle-XX/cycle.json)",
  "description": "State of one cycle. Created by sdd-orchestrator with status in-progress; only sdd-reviewer may set status completed (after the CONTEXTO GATE).",
  "type": "object",
  "required": [
    "cycle",
    "module",
    "spec",
    "apps",
    "status",
    "started_at",
    "completed_at",
    "documents",
    "artifacts",
    "metrics",
    "tables_created",
    "endpoints_implemented",
    "components_created",
    "issues_found",
    "reviewer_report"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "cycle": { "type": "integer", "minimum": 1 },
    "module": { "type": "string", "minLength": 1 },
    "spec": {
      "type": "string",
      "pattern": "^spec-[a-z0-9-]+-\\d{3}-[a-z0-9-]+$"
    },
    "apps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^(apps|libs|tools)/[a-z][a-z0-9-]*$"
      }
    },
    "phase": { "type": "string" },
    "flow": { "enum": ["full", "reduced"] },
    "objectives": { "type": "array", "items": { "type": "string" } },
    "status": { "enum": ["in-progress", "completed"] },
    "started_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "completed_at": {
      "oneOf": [
        { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        { "type": "null" }
      ]
    },
    "documents": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "brief": { "type": "string" },
        "functional": { "type": "string" },
        "planner": { "type": "string" },
        "architect": { "type": "string" },
        "tasks": {
          "type": "string",
          "description": "Path to the per-cycle tasks.json"
        }
      },
      "description": "Paths of the cycle documents that exist. flow: reduced cycles may omit functional/planner/architect."
    },
    "artifacts": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Support docs under cycle-XX/artifacts/, not implemented source files."
    },
    "metrics": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": [
            "tasks_total",
            "tasks_completed",
            "story_points",
            "files_created",
            "files_modified",
            "files_deleted"
          ],
          "additionalProperties": false,
          "properties": {
            "tasks_total": { "type": "integer", "minimum": 0 },
            "tasks_completed": { "type": "integer", "minimum": 0 },
            "tasks_skipped": {
              "type": "integer",
              "minimum": 0,
              "description": "Tasks closed as skipped (resolved / not applicable), not pending. Absent is read as 0. tasks_completed + tasks_skipped must equal tasks_total in a completed cycle."
            },
            "story_points": { "type": "number", "minimum": 0 },
            "files_created": { "type": "array", "items": { "type": "string" } },
            "files_modified": {
              "type": "array",
              "items": { "type": "string" }
            },
            "files_deleted": { "type": "array", "items": { "type": "string" } },
            "usage": {
              "type": "object",
              "required": ["tokens_in", "tokens_out"],
              "additionalProperties": false,
              "description": "Aggregated telemetry for the whole cycle, recorded by the reviewer at close (mandatory in the protocol; the field stays optional in the schema so cycles closed before v0.9.0 keep validating). Provider/model MUST be declared in by_tier. When the harness has no per-session counter (Copilot, Antigravity), record a declared estimate with approx: true and source: declared-estimate — never omit. Feeds the viewer's Costs dashboard.",
              "properties": {
                "tokens_in": { "type": "integer", "minimum": 0 },
                "tokens_out": { "type": "integer", "minimum": 0 },
                "duration_minutes": { "type": "number", "minimum": 0 },
                "approx": {
                  "type": "boolean",
                  "description": "true when the numbers are a declared estimate rather than a counter reading. The viewer marks these as \"estimado\". Absent is read as false (measured)."
                },
                "source": {
                  "$ref": "#/definitions/usageSource"
                },
                "by_tier": {
                  "type": "object",
                  "additionalProperties": false,
                  "description": "Keys are provider-namespaced models (claude/opus, gemini/pro, copilot/gpt-5-mini). Antigravity records under gemini/* — it runs Gemini models. Bare legacy keys (haiku|sonnet|opus|fable) are still accepted and read as claude/*.",
                  "propertyNames": {
                    "pattern": "^(haiku|sonnet|opus|fable|(claude|gemini|copilot)/[a-z0-9][a-z0-9.-]*)$"
                  },
                  "patternProperties": {
                    "^(haiku|sonnet|opus|fable|(claude|gemini|copilot)/[a-z0-9][a-z0-9.-]*)$": {
                      "type": "object",
                      "required": ["tokens_in", "tokens_out"],
                      "additionalProperties": false,
                      "description": "Per-model tokens. approx/source override the parent usage values for this model, so a cycle mixing a measured provider with an estimated one stays honest.",
                      "properties": {
                        "tokens_in": { "type": "integer", "minimum": 0 },
                        "tokens_out": { "type": "integer", "minimum": 0 },
                        "approx": { "type": "boolean" },
                        "source": { "$ref": "#/definitions/usageSource" }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "tables_created": { "type": "array", "items": { "type": "string" } },
    "endpoints_implemented": {
      "type": "array",
      "items": { "type": "string", "pattern": "^EP-\\d{3}$" }
    },
    "components_created": {
      "type": "array",
      "items": { "type": "string", "pattern": "^COMP-\\d{3}$" }
    },
    "issues_found": { "type": "array", "items": { "type": "string" } },
    "reviewer_report": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["approved", "date", "ca_results", "tests", "notes"],
          "additionalProperties": false,
          "properties": {
            "approved": { "type": "boolean" },
            "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
            "ca_results": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            },
            "tests": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            },
            "notes": { "type": "string" },
            "follow_ups": { "type": "array", "items": { "type": "string" } }
          }
        }
      ]
    }
  },
  "definitions": {
    "usageSource": {
      "type": "string",
      "enum": [
        "session-report",
        "stats-command",
        "api-usage",
        "declared-estimate"
      ],
      "description": "Where the number came from. session-report: the harness session usage report (Claude Code). stats-command: /stats (Gemini CLI). api-usage: usage returned by the model API. declared-estimate: the agent declared an order-of-magnitude estimate because the harness exposes no counter (Copilot, Antigravity) — pair it with approx: true."
    }
  }
}
