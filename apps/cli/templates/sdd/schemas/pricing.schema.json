{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "sdd/schemas/pricing.schema.json",
  "title": "SDD Pricing (sdd/pricing.json)",
  "description": "Tarifas editables que el visor SDD usa para la comparativa de costos: estimación tradicional (horas × tarifa) versus costo agéntico aproximado (tokens × precio por tier). No afecta al ciclo SDD — es solo entrada del dashboard.",
  "type": "object",
  "required": ["currency", "traditional_hourly_rate", "model_prices_per_mtok"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "_description": { "type": "string" },
    "currency": { "type": "string", "minLength": 3, "maxLength": 3 },
    "traditional_hourly_rate": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "Costo por hora de desarrollo tradicional usado contra estimation_hours de las tasks."
    },
    "model_prices_per_mtok": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "haiku": { "$ref": "#/definitions/TierPrice" },
        "sonnet": { "$ref": "#/definitions/TierPrice" },
        "opus": { "$ref": "#/definitions/TierPrice" },
        "fable": { "$ref": "#/definitions/TierPrice" }
      }
    },
    "prices_updated_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  },
  "definitions": {
    "TierPrice": {
      "type": "object",
      "required": ["input", "output"],
      "additionalProperties": false,
      "properties": {
        "input": { "type": "number", "minimum": 0 },
        "output": { "type": "number", "minimum": 0 }
      }
    }
  }
}
